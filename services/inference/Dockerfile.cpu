FROM python:3.12.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MODEL_PATH=/models/tile-detector.onnx \
    REQUIRE_CUDA=false \
    MODEL_CLASS_PROFILE=riichicast-v2 \
    PORT=8080

ARG MODEL_FILE=services/inference/models/riichicast-v2.onnx

WORKDIR /srv

COPY services/inference/requirements-cpu.txt ./requirements.txt
RUN python -m pip install --no-cache-dir -r requirements.txt

COPY services/inference/app ./app
COPY ${MODEL_FILE} /models/tile-detector.onnx

RUN useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /srv /models
USER appuser

EXPOSE 8080

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-access-log"]
